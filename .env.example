# ─────────────────────────────────────────────────────────────
# 本地后台（网站编辑器）配置
# 用法：把本文件复制成 .env，填好 ADMIN_PASSWORD 和 GITHUB_TOKEN。
# .env 已在 .gitignore 里，不会进仓库、不会进浏览器。
# 启动：npm start   →  浏览器打开 http://127.0.0.1:3000/admin/
# ─────────────────────────────────────────────────────────────

# 后台登录密码。随便设一个长的；局域网里谁能打开后台就看这个。
ADMIN_PASSWORD=change-me

# GitHub 细粒度 token —— 只有「传大文件到 Releases」需要它。
# 怎么建：GitHub → 右上头像 → Settings → Developer settings
#         → Personal access tokens → Fine-grained tokens → Generate new token
#   Repository access: Only select repositories → 只勾 CupCakeQAQ-site
#   Permissions → Repository permissions → Contents: Read and write
# （Releases 属于 Contents 权限，不需要再勾别的）
# 生成后粘到等号后面。它只存在你这台电脑上，泄露 = 别人能改这个仓库，碰不到账号其它东西。
GITHUB_TOKEN=

# 仓库 / 分支 / Releases 的 tag 名（一般不用改）
GITHUB_REPO=cupcakeqaq-cloud/CupCakeQAQ-site
GIT_BRANCH=main
RELEASE_TAG=assets

# git 可执行文件：系统 PATH 里没有 git，所以写 GitHub Desktop 自带的完整路径
GIT_PATH=C:\Users\CupCakeQAQ_\AppData\Local\GitHubDesktop\app-3.6.6\resources\app\git\cmd\git.exe

# 会话签名密钥：留空则第一次启动自动生成并写回本文件
SESSION_SECRET=

# ─────────────────────────────────────────────────────────────
# 留言板云端（Cloudflare Worker + KV）
# 只有「推送留言到Cloudflare.bat」（把后台里的留言搬进云端）用这两个。
# 访客端读取留言不用这里的配置，前台地址写在 js/config.js。
# ─────────────────────────────────────────────────────────────

# Worker 地址：Cloudflare 里那个 Worker 的网址，像 https://cupcake-gb.xxx.workers.dev
GB_WORKER_URL=

# 钥匙：和 Cloudflare 里 GB_TOKEN 这个 Secret 填的一模一样（自己随便生成一串长的）
GB_TOKEN=
