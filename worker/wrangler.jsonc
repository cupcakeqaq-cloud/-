// Cloudflare Worker 部署配置（给 wrangler 用）
// 用法：在 worker/ 目录里跑 `npx wrangler deploy`（或双击根目录的「部署到Cloudflare.bat」）
// 这里没有钥匙：GB_TOKEN 放在 Cloudflare 的 Secret 里，不在本文件。
{
  "name": "cupcake-gb",
  "main": "guestbook.mjs",
  "compatibility_date": "2026-10-12",
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true
    }
  },
  "kv_namespaces": [
    {
      "binding": "GB_KV",
      "id": "0727b2d9ef0b41de846e64c8b2d68e19"
    }
  ]
}
